# ===========================================
# Aman AI - Environment Variables Example
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git!

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/amanai"

# NextAuth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Backend API
BACKEND_URL="http://localhost:8000"
SECRET_KEY="replace-with-strong-random-secret"
# Optional MRI segmentation model (U-Net / EfficientNet-B7 checkpoint)
# AMAN_MRI_SEGMENTATION_CKPT="/models/model_checkpoint.pth"
# AMAN_MRI_SEGMENTATION_DEVICE="cpu"

# Production (uncomment for deployment)
# NODE_ENV="production"
# AUTH_URL="https://amanai.kz"

# Deployment mode
AMAN_DEPLOYMENT_MODE="local"
SITE_CONFIG_PATH=".aman-site-config.json"

# Site and integration endpoints
SITE_NAME="Aman AI"
DICOM_ENDPOINT="http://localhost:8042/dicom-web"
FHIR_ENDPOINT="http://localhost:8080/fhir"
INFERENCE_ENDPOINT="http://localhost:3000/api/inference/jobs"

# VAPI webhook verification
VAPI_WEBHOOK_SECRET="replace-with-vapi-webhook-secret"
# Local-only bypass for unsigned webhook testing; never enable in production.
VAPI_WEBHOOK_ALLOW_UNSIGNED="false"

# OIDC / SSO foundation (no client secret here)
OIDC_ISSUER="http://localhost:5556"
OIDC_CLIENT_ID="aman-local"
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback/oidc"

# OpenMed NER Integration (SCRUM-70)
OPENMED_MODEL_NAME=OpenMed/OpenMed-PII-SuperClinical-Small-44M-v1
OPENMED_DEVICE=cpu
PII_DEIDENTIFICATION_ENABLED=true
OPENMED_CACHE_DIR=/app/.cache/openmed
